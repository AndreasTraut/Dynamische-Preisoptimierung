{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/SemanticModel/definition/1.0.0/semanticModelDefinition.schema.json",
  "description": "Tabular Model für das Dynamische Preisoptimierungsmodell im eCommerce",
  "version": "1.0",
  "author": "Andreas Traut",
  "studienarbeit": "Dynamisches Preisoptimierungsmodell im eCommerce",
  "compatibilityLevel": 1550,
  "culture": "de-DE",

  "dataModel": {
    "name": "PricingPrototypeDB",
    "description": "Semantisches Modell für das dynamische Preisoptimierungsmodell. Quellsystem: SQLite / CSV-Dateien.",

    "parameters": [
      {
        "name": "DataPath",
        "type": "Text",
        "defaultValue": "../data",
        "description": "Relativer Pfad zum data/-Verzeichnis des Projekts (CSV-Quelldaten)."
      }
    ],

    "tables": [
      {
        "name": "Produkte",
        "schicht": "Core / Stammdaten",
        "description": "Produktstammdaten (5 Produkte). Entspricht dbo.Produkte im SQL Server DWH.",
        "columns": [
          { "name": "produkt_id",     "dataType": "Text",    "key": true,  "description": "Natürlicher Schlüssel des Produkts (P001–P005)" },
          { "name": "name",           "dataType": "Text",    "key": false, "description": "Produktname" },
          { "name": "kategorie",      "dataType": "Text",    "key": false, "description": "Produktkategorie (Elektronik, Haushalt, Sport)" },
          { "name": "einstandspreis", "dataType": "Decimal", "key": false, "description": "Einkaufspreis (Untergrenze für Margenberechnung) in €" },
          { "name": "mindestpreis",   "dataType": "Decimal", "key": false, "description": "Absoluter Mindestpreis für Preisempfehlung in €" },
          { "name": "listenpreis",    "dataType": "Decimal", "key": false, "description": "Listenpreis / UVP in €" }
        ],
        "data": [
          { "produkt_id": "P001", "name": "Produkt A", "kategorie": "Elektronik", "einstandspreis": 30.00, "mindestpreis": 35.00, "listenpreis": 59.99 },
          { "produkt_id": "P002", "name": "Produkt B", "kategorie": "Elektronik", "einstandspreis": 50.00, "mindestpreis": 60.00, "listenpreis": 99.99 },
          { "produkt_id": "P003", "name": "Produkt C", "kategorie": "Haushalt",   "einstandspreis": 10.00, "mindestpreis": 14.00, "listenpreis": 24.99 },
          { "produkt_id": "P004", "name": "Produkt D", "kategorie": "Haushalt",   "einstandspreis": 15.00, "mindestpreis": 19.00, "listenpreis": 34.99 },
          { "produkt_id": "P005", "name": "Produkt E", "kategorie": "Sport",      "einstandspreis": 20.00, "mindestpreis": 25.00, "listenpreis": 44.99 }
        ]
      },
      {
        "name": "Verkaeufe",
        "schicht": "Core / Faktdaten",
        "description": "Tägliche Verkaufstransaktionen je Produkt (365 Tage). Entspricht dbo.Verkaeufe im SQL Server DWH.",
        "source": { "type": "CSV", "file": "data/verkaeufe.csv" },
        "columns": [
          { "name": "verkauf_id", "dataType": "Integer", "key": true,  "description": "Technischer Primärschlüssel" },
          { "name": "produkt_id", "dataType": "Text",    "key": false, "description": "Fremdschlüssel → Produkte" },
          { "name": "datum",      "dataType": "Date",    "key": false, "description": "Verkaufsdatum" },
          { "name": "menge",      "dataType": "Integer", "key": false, "description": "Verkaufte Menge (Stück)" },
          { "name": "preis",      "dataType": "Decimal", "key": false, "description": "Tatsächlicher Verkaufspreis in €" },
          { "name": "umsatz",     "dataType": "Decimal", "key": false, "description": "Tageserlös = menge × preis in €" }
        ]
      },
      {
        "name": "Wettbewerbspreise",
        "schicht": "Core / Externe Daten",
        "description": "Wöchentliche Wettbewerbspreise je Produkt. Entspricht dbo.Wettbewerbspreise im SQL Server DWH.",
        "source": { "type": "CSV", "file": "data/wettbewerbspreise.csv" },
        "columns": [
          { "name": "produkt_id",       "dataType": "Text",    "key": false, "description": "Fremdschlüssel → Produkte" },
          { "name": "datum",            "dataType": "Date",    "key": false, "description": "Erfassungsdatum (wöchentlich)" },
          { "name": "wettbewerbspreis", "dataType": "Decimal", "key": false, "description": "Beobachteter Wettbewerbspreis in €" }
        ]
      },
      {
        "name": "ModelOutput",
        "schicht": "Datamart / ML-Ergebnisse",
        "description": "Modellergebnisse und Preisempfehlungen aus dem ML-Modell (Ridge-Regression). Entspricht dbo.ModelOutput im SQL Server DWH. Berechnet durch src/pricing_optimizer.py.",
        "columns": [
          { "name": "produkt_id",                "dataType": "Text",    "key": false, "description": "Fremdschlüssel → Produkte" },
          { "name": "preiselastizitaet",          "dataType": "Decimal", "key": false, "description": "Geschätzte Preiselastizität ε der Nachfrage (log-log Regression)" },
          { "name": "modell_r2",                  "dataType": "Decimal", "key": false, "description": "Bestimmtheitsmaß R² des Elastizitätsmodells" },
          { "name": "aktueller_preis",            "dataType": "Decimal", "key": false, "description": "Zuletzt erzielter Verkaufspreis P₀ in €" },
          { "name": "wettbewerbspreis",           "dataType": "Decimal", "key": false, "description": "Aktueller Wettbewerbspreis P_w in €" },
          { "name": "empfohlener_preis",          "dataType": "Decimal", "key": false, "description": "Optimaler Empfehlungspreis P* (Amoroso-Robinson + Business Rules) in €" },
          { "name": "erwartete_mengenänderung",   "dataType": "Decimal", "key": false, "description": "Erwartete Mengenänderung ΔQ in % (ceteris paribus)" },
          { "name": "erwartete_umsatzaenderung",  "dataType": "Decimal", "key": false, "description": "Erwartete Umsatzänderung ΔU in %" },
          { "name": "erwartete_margenänderung",   "dataType": "Decimal", "key": false, "description": "Erwartete Margenänderung ΔM in %" }
        ],
        "data": [
          {
            "produkt_id": "P001", "preiselastizitaet": -1.183, "modell_r2": 0.609,
            "aktueller_preis": 63.57, "wettbewerbspreis": 62.67, "empfohlener_preis": 76.28,
            "erwartete_mengenänderung": -23.6, "erwartete_umsatzaenderung": -8.4, "erwartete_margenänderung": 5.3
          },
          {
            "produkt_id": "P002", "preiselastizitaet": -1.047, "modell_r2": 0.417,
            "aktueller_preis": 102.71, "wettbewerbspreis": 98.27, "empfohlener_preis": 104.97,
            "erwartete_mengenänderung": -2.3, "erwartete_umsatzaenderung": -0.2, "erwartete_margenänderung": 1.9
          },
          {
            "produkt_id": "P003", "preiselastizitaet": -1.317, "modell_r2": 0.570,
            "aktueller_preis": 24.63, "wettbewerbspreis": 22.99, "empfohlener_preis": 29.56,
            "erwartete_mengenänderung": -26.4, "erwartete_umsatzaenderung": -11.6, "erwartete_margenänderung": -1.6
          },
          {
            "produkt_id": "P004", "preiselastizitaet": -0.525, "modell_r2": 0.499,
            "aktueller_preis": 30.39, "wettbewerbspreis": 38.72, "empfohlener_preis": 33.95,
            "erwartete_mengenänderung": -6.2, "erwartete_umsatzaenderung": 4.9, "erwartete_margenänderung": 15.6
          },
          {
            "produkt_id": "P005", "preiselastizitaet": -0.656, "modell_r2": 0.442,
            "aktueller_preis": 45.37, "wettbewerbspreis": 49.96, "empfohlener_preis": 48.33,
            "erwartete_mengenänderung": -4.3, "erwartete_umsatzaenderung": 2.0, "erwartete_margenänderung": 6.9
          }
        ],
        "businessRules": {
          "mindestmarge": "10% auf Einstandspreis",
          "maxPreisänderung": "±20% je Empfehlung",
          "wettbewerbsGewicht": "30% Gewichtung des Wettbewerbspreises",
          "formel": "P* = C / (1 + 1/ε)  [Amoroso-Robinson-Relation, nur für |ε| > 1]"
        }
      },
      {
        "name": "Datum",
        "schicht": "Dimension",
        "description": "Datumsdimension (Kalenderjahr 2023). Wird als berechnete Tabelle (DAX CALENDAR) erzeugt.",
        "source": {
          "type": "DAX",
          "expression": "ADDCOLUMNS(CALENDAR(DATE(2023,1,1), DATE(2023,12,31)), \"Jahr\", YEAR([Date]), ...)"
        },
        "columns": [
          { "name": "Datum",        "dataType": "Date",    "key": true },
          { "name": "Jahr",         "dataType": "Integer" },
          { "name": "Quartal",      "dataType": "Text" },
          { "name": "Monat Nr",     "dataType": "Integer" },
          { "name": "Monatsname",   "dataType": "Text" },
          { "name": "KW",           "dataType": "Integer" },
          { "name": "Wochentag Nr", "dataType": "Integer" },
          { "name": "Wochentag",    "dataType": "Text" }
        ]
      }
    ],

    "relationships": [
      {
        "name": "Verkaeufe → Produkte",
        "from": { "table": "Verkaeufe",         "column": "produkt_id" },
        "to":   { "table": "Produkte",           "column": "produkt_id" },
        "cardinality": "many-to-one",
        "crossFilter": "single"
      },
      {
        "name": "Wettbewerbspreise → Produkte",
        "from": { "table": "Wettbewerbspreise",  "column": "produkt_id" },
        "to":   { "table": "Produkte",           "column": "produkt_id" },
        "cardinality": "many-to-one",
        "crossFilter": "single"
      },
      {
        "name": "ModelOutput → Produkte",
        "from": { "table": "ModelOutput",        "column": "produkt_id" },
        "to":   { "table": "Produkte",           "column": "produkt_id" },
        "cardinality": "many-to-one",
        "crossFilter": "single"
      },
      {
        "name": "Verkaeufe → Datum",
        "from": { "table": "Verkaeufe",          "column": "datum" },
        "to":   { "table": "Datum",              "column": "Datum" },
        "cardinality": "many-to-one",
        "crossFilter": "single"
      }
    ],

    "measures": {
      "displayFolders": {
        "Preise": [
          {
            "name": "Aktueller Preis Ø",
            "dax": "AVERAGE(ModelOutput[aktueller_preis])",
            "format": "#,0.00 €",
            "description": "Durchschnittlicher aktueller Verkaufspreis über alle selektierten Produkte (AC)"
          },
          {
            "name": "Empfohlener Preis Ø",
            "dax": "AVERAGE(ModelOutput[empfohlener_preis])",
            "format": "#,0.00 €",
            "description": "Durchschnittlicher empfohlener Preis P* über alle selektierten Produkte (PL)"
          },
          {
            "name": "Wettbewerbspreis Ø",
            "dax": "AVERAGE(ModelOutput[wettbewerbspreis])",
            "format": "#,0.00 €",
            "description": "Durchschnittlicher Wettbewerbspreis P_w"
          },
          {
            "name": "Preisänderung Absolut",
            "dax": "[Empfohlener Preis Ø] - [Aktueller Preis Ø]",
            "format": "+#,0.00 €;-#,0.00 €;0,00 €",
            "description": "Absolute Preisdifferenz (P* - P₀)"
          },
          {
            "name": "Preisänderung %",
            "dax": "DIVIDE([Empfohlener Preis Ø] - [Aktueller Preis Ø], [Aktueller Preis Ø])",
            "format": "+0.0%;-0.0%;0.0%",
            "description": "Relative Preisänderung in %"
          }
        ],
        "Modell": [
          {
            "name": "Preiselastizität Ø",
            "dax": "AVERAGE(ModelOutput[preiselastizitaet])",
            "format": "0.000",
            "description": "Durchschnittliche Preiselastizität ε der Nachfrage (negativ = inverse Beziehung Preis/Menge)"
          },
          {
            "name": "Modell R² Ø",
            "dax": "AVERAGE(ModelOutput[modell_r2])",
            "format": "0.000",
            "description": "Durchschnittliches Bestimmtheitsmaß R² der Elastizitätsmodelle"
          },
          {
            "name": "Preis-Elastizitäts-Klasse",
            "dax": "VAR eps = [Preiselastizität Ø] RETURN IF(eps >= 0, \"Positiv (Giffen)\", IF(eps >= -1, \"Unelastisch (|ε| < 1)\", IF(eps >= -1.05, \"Nahe Einheitselastizität\", \"Elastisch (|ε| > 1)\")))",
            "description": "Klassifikation der Preiselastizität nach Nachfragetyp"
          }
        ],
        "Erwartete Änderungen": [
          {
            "name": "ΔMenge % Ø",
            "dax": "DIVIDE(AVERAGE(ModelOutput[erwartete_mengenänderung]), 100)",
            "format": "+0.0%;-0.0%;0.0%",
            "description": "Erwartete Mengenänderung bei Umsetzung der Preisempfehlung (ceteris paribus)"
          },
          {
            "name": "ΔUmsatz % Ø",
            "dax": "DIVIDE(AVERAGE(ModelOutput[erwartete_umsatzaenderung]), 100)",
            "format": "+0.0%;-0.0%;0.0%",
            "description": "Erwartete Umsatzänderung bei Umsetzung der Preisempfehlung"
          },
          {
            "name": "ΔMarge % Ø",
            "dax": "DIVIDE(AVERAGE(ModelOutput[erwartete_margenänderung]), 100)",
            "format": "+0.0%;-0.0%;0.0%",
            "description": "Erwartete Margenänderung bei Umsetzung der Preisempfehlung"
          }
        ],
        "Umsatz": [
          {
            "name": "Gesamtumsatz AC",
            "dax": "SUM(Verkaeufe[umsatz])",
            "format": "#,0 €",
            "description": "Tatsächlicher Gesamtumsatz (Istwert, AC) im gewählten Zeitraum"
          },
          {
            "name": "Ø Tagesumsatz",
            "dax": "AVERAGEX(VALUES(Verkaeufe[datum]), SUM(Verkaeufe[umsatz]))",
            "format": "#,0.00 €",
            "description": "Durchschnittlicher Tagesumsatz"
          }
        ]
      }
    },

    "ibcsHinweise": {
      "notation": {
        "AC": "Istwert (Aktueller Preis, tatsächliche Verkäufe)",
        "PL": "Planwert / Empfehlung (Empfohlener Preis, ML-Modell)",
        "Δ":  "Abweichung (Preisänderung, ΔMarge, ΔUmsatz, ΔMenge)"
      },
      "farben": {
        "AC_schwarz":      "#000000 – Istwerte (Aktueller Preis, tatsächlicher Umsatz)",
        "PL_dunkelgrau":   "#404040 – Planwerte / Empfehlungen",
        "positiv_gruen":   "#1F7A1F – Positive Abweichungen (ΔMarge > 0)",
        "negativ_rot":     "#C0392B – Negative Abweichungen (ΔMarge < 0)",
        "wettbewerb_grau": "#808080 – Wettbewerbspreis (Referenzlinie)"
      },
      "diagrammtypen": {
        "preisvergleich":   "Clustered Bar Chart: Aktueller Preis (AC) vs. Empfohlener Preis (PL) je Produkt",
        "abweichungen":     "Bar Chart: ΔMarge %, ΔUmsatz % je Produkt (positiv = grün, negativ = rot)",
        "zeitreihe":        "Line Chart: Täglicher Umsatz über Zeit (Verkaeufe)",
        "kennzahlenkarten": "Card Visuals: Ø Akt. Preis | Ø Empf. Preis | Ø ΔMarge | Ø R²",
        "detail":           "Matrix/Table: Alle Produkte mit vollständigen Modellergebnissen"
      }
    }
  }
}
