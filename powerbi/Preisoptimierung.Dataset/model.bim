        ]
      },
      {
        "name": "Datum",
        "lineageTag": "t-datum-001",
        "isHidden": false,
        "columns": [
          {
            "name": "Datum",
            "dataType": "dateTime",
            "lineageTag": "c-datum-datum",
            "sourceColumn": "Datum",
            "summarizeBy": "none",
            "isKey": true,
            "formatString": "dd.MM.yyyy",
            "annotations": [
              { "name": "SummarizationSetBy", "value": "Automatic" },
              { "name": "UnderlyingDateTimeDataType", "value": "Date" }
            ]
          },
          {
            "name": "Jahr",
            "dataType": "int64",
            "lineageTag": "c-datum-jahr",
            "sourceColumn": "Jahr",
            "summarizeBy": "none",
            "annotations": [
              { "name": "SummarizationSetBy", "value": "User" }
            ]
          },
          {
            "name": "Quartal",
            "dataType": "string",
            "lineageTag": "c-datum-quartal",
            "sourceColumn": "Quartal",
            "summarizeBy": "none",
            "annotations": [
              { "name": "SummarizationSetBy", "value": "Automatic" }
            ]
          },
          {
            "name": "Monat Nr",
            "dataType": "int64",
            "lineageTag": "c-datum-monat-nr",
            "sourceColumn": "Monat Nr",
            "summarizeBy": "none",
            "annotations": [
              { "name": "SummarizationSetBy", "value": "User" }
            ]
          },
          {
            "name": "Monatsname",
            "dataType": "string",
            "lineageTag": "c-datum-monatsname",
            "sourceColumn": "Monatsname",
            "summarizeBy": "none",
            "sortByColumn": "Monat Nr",
            "annotations": [
              { "name": "SummarizationSetBy", "value": "Automatic" }
            ]
          },
          {
            "name": "KW",
            "dataType": "int64",
            "lineageTag": "c-datum-kw",
            "sourceColumn": "KW",
            "summarizeBy": "none",
            "annotations": [
              { "name": "SummarizationSetBy", "value": "User" }
            ]
          },
          {
            "name": "Wochentag Nr",
            "dataType": "int64",
            "lineageTag": "c-datum-wochentag-nr",
            "sourceColumn": "Wochentag Nr",
            "summarizeBy": "none",
            "annotations": [
              { "name": "SummarizationSetBy", "value": "User" }
            ]
          },
          {
            "name": "Wochentag",
            "dataType": "string",
            "lineageTag": "c-datum-wochentag",
            "sourceColumn": "Wochentag",
            "summarizeBy": "none",
            "sortByColumn": "Wochentag Nr",
            "annotations": [
              { "name": "SummarizationSetBy", "value": "Automatic" }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Datum-Partition",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "ADDCOLUMNS(",
                "    CALENDAR(DATE(2023,1,1), DATE(2023,12,31)),",
                "    \"Jahr\",        YEAR([Date]),",
                "    \"Quartal\",     \"Q\" & FORMAT(ROUNDUP(MONTH([Date])/3,0),\"0\"),",
                "    \"Monat Nr\",    MONTH([Date]),",
                "    \"Monatsname\",  FORMAT([Date], \"MMMM\", \"de-DE\"),",
                "    \"KW\",          WEEKNUM([Date], 2),",
                "    \"Wochentag Nr\",WEEKDAY([Date], 2),",
                "    \"Wochentag\",   FORMAT([Date], \"DDDD\", \"de-DE\")",
                ")"
              ]
            }
          }
        ],
        "annotations": [
          { "name": "PBI_ResultType", "value": "Table" }
        ]
      }
    ],
