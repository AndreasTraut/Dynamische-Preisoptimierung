              { "name": "PBI_FormatHint", "value": "{\"currencyCulture\":\"de-DE\"}" }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Produkte-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRows(",
                "        {",
                "            {\"P001\", \"Produkt A\", \"Elektronik\", 30.0, 35.0, 59.99},",
                "            {\"P002\", \"Produkt B\", \"Elektronik\", 50.0, 60.0, 99.99},",
                "            {\"P003\", \"Produkt C\", \"Haushalt\",   10.0, 14.0, 24.99},",
                "            {\"P004\", \"Produkt D\", \"Haushalt\",   15.0, 19.0, 34.99},",
                "            {\"P005\", \"Produkt E\", \"Sport\",      20.0, 25.0, 44.99}",
                "        },",
                "        type table [",
                "            produkt_id     = Text.Type,",
                "            name           = Text.Type,",
                "            kategorie      = Text.Type,",
                "            einstandspreis = Decimal.Type,",
                "            mindestpreis   = Decimal.Type,",
                "            listenpreis    = Decimal.Type",
                "        ]",
                "    )",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "annotations": [
          { "name": "PBI_ResultType", "value": "Table" }
        ]
      },
      {
        "name": "ModelOutput",
        "lineageTag": "t-modeloutput-001",
        "columns": [
          {
            "name": "produkt_id",
            "dataType": "string",
            "lineageTag": "c-mo-produkt-id",
            "sourceColumn": "produkt_id",
            "summarizeBy": "none",
            "annotations": [
              { "name": "SummarizationSetBy", "value": "Automatic" }
            ]
          },
          {
            "name": "preiselastizitaet",
            "dataType": "decimal",
            "lineageTag": "c-mo-elastizitaet",
            "sourceColumn": "preiselastizitaet",
            "summarizeBy": "average",
            "formatString": "0.000",
            "annotations": [
              { "name": "SummarizationSetBy", "value": "Automatic" }
            ]
          },
          {
            "name": "modell_r2",
            "dataType": "decimal",
            "lineageTag": "c-mo-r2",
            "sourceColumn": "modell_r2",
            "summarizeBy": "average",
            "formatString": "0.000",
            "annotations": [
              { "name": "SummarizationSetBy", "value": "Automatic" }
            ]
          },
          {
            "name": "aktueller_preis",
            "dataType": "decimal",
            "lineageTag": "c-mo-akt-preis",
            "sourceColumn": "aktueller_preis",
            "summarizeBy": "average",
            "formatString": "#,0.00\" €\"",
            "annotations": [
              { "name": "SummarizationSetBy", "value": "Automatic" },
              { "name": "PBI_FormatHint", "value": "{\"currencyCulture\":\"de-DE\"}" }
            ]
          },
          {
            "name": "wettbewerbspreis",
            "dataType": "decimal",
            "lineageTag": "c-mo-wettbewerb",
            "sourceColumn": "wettbewerbspreis",
            "summarizeBy": "average",
            "formatString": "#,0.00\" €\"",
            "annotations": [
              { "name": "SummarizationSetBy", "value": "Automatic" },
              { "name": "PBI_FormatHint", "value": "{\"currencyCulture\":\"de-DE\"}" }
            ]
          },
          {
            "name": "empfohlener_preis",
            "dataType": "decimal",
            "lineageTag": "c-mo-empf-preis",
            "sourceColumn": "empfohlener_preis",
            "summarizeBy": "average",
            "formatString": "#,0.00\" €\"",
            "annotations": [
              { "name": "SummarizationSetBy", "value": "Automatic" },
              { "name": "PBI_FormatHint", "value": "{\"currencyCulture\":\"de-DE\"}" }
            ]
          },
          {
            "name": "erwartete_mengenänderung",
            "dataType": "decimal",
            "lineageTag": "c-mo-delta-menge",
            "sourceColumn": "erwartete_mengenänderung",
            "summarizeBy": "average",
            "formatString": "+0.0%;-0.0%;0.0%",
            "annotations": [
              { "name": "SummarizationSetBy", "value": "Automatic" }
            ]
          },
          {
            "name": "erwartete_umsatzaenderung",
            "dataType": "decimal",
            "lineageTag": "c-mo-delta-umsatz",
            "sourceColumn": "erwartete_umsatzaenderung",
            "summarizeBy": "average",
            "formatString": "+0.0%;-0.0%;0.0%",
            "annotations": [
              { "name": "SummarizationSetBy", "value": "Automatic" }
            ]
          },
          {
            "name": "erwartete_margenänderung",
            "dataType": "decimal",
            "lineageTag": "c-mo-delta-marge",
            "sourceColumn": "erwartete_margenänderung",
            "summarizeBy": "average",
            "formatString": "+0.0%;-0.0%;0.0%",
            "annotations": [
              { "name": "SummarizationSetBy", "value": "Automatic" }
            ]
          }
        ],
        "measures": [
          {
            "name": "Aktueller Preis Ø",
            "lineageTag": "m-akt-preis",
            "expression": "AVERAGE(ModelOutput[aktueller_preis])",
            "formatString": "#,0.00 \"€\"",
            "displayFolder": "Preise",
            "annotations": [
              { "name": "PBI_FormatHint", "value": "{\"currencyCulture\":\"de-DE\"}" }
            ]
          },
          {
            "name": "Empfohlener Preis Ø",
            "lineageTag": "m-empf-preis",
            "expression": "AVERAGE(ModelOutput[empfohlener_preis])",
            "formatString": "#,0.00 \"€\"",
            "displayFolder": "Preise",
            "annotations": [
              { "name": "PBI_FormatHint", "value": "{\"currencyCulture\":\"de-DE\"}" }
            ]
          },
          {
            "name": "Wettbewerbspreis Ø",
            "lineageTag": "m-wettbewerb-preis",
            "expression": "AVERAGE(ModelOutput[wettbewerbspreis])",
            "formatString": "#,0.00 \"€\"",
            "displayFolder": "Preise",
            "annotations": [
              { "name": "PBI_FormatHint", "value": "{\"currencyCulture\":\"de-DE\"}" }
            ]
          },
          {
            "name": "Preisänderung Absolut",
            "lineageTag": "m-preisänderung-abs",
            "expression": "[Empfohlener Preis Ø] - [Aktueller Preis Ø]",
            "formatString": "+#,0.00 \"€\";-#,0.00 \"€\";0,00 \"€\"",
            "displayFolder": "Preise",
            "annotations": [
              { "name": "PBI_FormatHint", "value": "{\"currencyCulture\":\"de-DE\"}" }
            ]
          },
          {
            "name": "Preisänderung %",
            "lineageTag": "m-preisänderung-pct",
            "expression": "DIVIDE([Empfohlener Preis Ø] - [Aktueller Preis Ø], [Aktueller Preis Ø])",
            "formatString": "+0.0%;-0.0%;0.0%",
            "displayFolder": "Preise"
          },
          {
            "name": "Preiselastizität Ø",
            "lineageTag": "m-elastizitaet",
            "expression": "AVERAGE(ModelOutput[preiselastizitaet])",
            "formatString": "0.000",
            "displayFolder": "Modell"
          },
          {
            "name": "Modell R² Ø",
            "lineageTag": "m-r2",
            "expression": "AVERAGE(ModelOutput[modell_r2])",
            "formatString": "0.000",
            "displayFolder": "Modell"
          },
          {
            "name": "ΔMenge % Ø",
            "lineageTag": "m-delta-menge",
            "expression": "DIVIDE(AVERAGE(ModelOutput[erwartete_mengenänderung]), 100)",
            "formatString": "+0.0%;-0.0%;0.0%",
            "displayFolder": "Erwartete Änderungen"
          },
          {
            "name": "ΔUmsatz % Ø",
            "lineageTag": "m-delta-umsatz",
            "expression": "DIVIDE(AVERAGE(ModelOutput[erwartete_umsatzaenderung]), 100)",
            "formatString": "+0.0%;-0.0%;0.0%",
            "displayFolder": "Erwartete Änderungen"
          },
          {
            "name": "ΔMarge % Ø",
            "lineageTag": "m-delta-marge",
            "expression": "DIVIDE(AVERAGE(ModelOutput[erwartete_margenänderung]), 100)",
            "formatString": "+0.0%;-0.0%;0.0%",
            "displayFolder": "Erwartete Änderungen"
          },
          {
            "name": "Gesamtumsatz AC",
            "lineageTag": "m-gesamtumsatz",
            "expression": "SUM(Verkaeufe[umsatz])",
            "formatString": "#,0 \"€\"",
            "displayFolder": "Umsatz",
            "annotations": [
              { "name": "PBI_FormatHint", "value": "{\"currencyCulture\":\"de-DE\"}" }
            ]
          },
          {
            "name": "Ø Tagesumsatz",
            "lineageTag": "m-avg-tagesumsatz",
            "expression": "AVERAGEX(VALUES(Verkaeufe[datum]), SUM(Verkaeufe[umsatz]))",
            "formatString": "#,0.00 \"€\"",
            "displayFolder": "Umsatz",
            "annotations": [
              { "name": "PBI_FormatHint", "value": "{\"currencyCulture\":\"de-DE\"}" }
            ]
          },
          {
            "name": "Preis-Elastizitäts-Klasse",
            "lineageTag": "m-elastizitaet-klasse",
            "expression": [
              "VAR eps = [Preiselastizität Ø]",
              "RETURN",
              "    IF(eps >= 0, \"Positiv (Giffen)\",",
              "    IF(eps >= -1, \"Unelastisch (|ε| < 1)\",",
              "    IF(eps >= -1.05, \"Nahe Einheitselastizität\",",
              "    \"Elastisch (|ε| > 1)\")))"
            ],
            "displayFolder": "Modell"
          }
        ],
        "partitions": [
          {
            "name": "ModelOutput-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRows(",
                "        {",
                "            {\"P001\", -1.183, 0.609, 63.57, 62.67,  76.28, -23.6, -8.4,   5.3},",
                "            {\"P002\", -1.047, 0.417, 102.71, 98.27, 104.97,  -2.3, -0.2,  1.9},",
                "            {\"P003\", -1.317, 0.570,  24.63, 22.99,  29.56, -26.4,-11.6, -1.6},",
                "            {\"P004\", -0.525, 0.499,  30.39, 38.72,  33.95,  -6.2,  4.9, 15.6},",
                "            {\"P005\", -0.656, 0.442,  45.37, 49.96,  48.33,  -4.3,  2.0,  6.9}",
                "        },",
                "        type table [",
                "            produkt_id                = Text.Type,",
                "            preiselastizitaet         = Decimal.Type,",
                "            modell_r2                 = Decimal.Type,",
                "            aktueller_preis           = Decimal.Type,",
                "            wettbewerbspreis          = Decimal.Type,",
                "            empfohlener_preis         = Decimal.Type,",
                "            erwartete_mengenänderung  = Decimal.Type,",
                "            erwartete_umsatzaenderung = Decimal.Type,",
                "            erwartete_margenänderung  = Decimal.Type",
                "        ]",
                "    )",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "annotations": [
          { "name": "PBI_ResultType", "value": "Table" }
        ]
      },
