            ]
          }
        ],
        "partitions": [
          {
            "name": "Verkaeufe-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    DataPath = try #\"DataPath\" otherwise \"../data\",",
                "    Quelle = Csv.Document(",
                "        File.Contents(DataPath & \"/verkaeufe.csv\"),",
                "        [Delimiter=\",\", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.None]",
                "    ),",
                "    HeadersHochgestuft = Table.PromoteHeaders(Quelle, [PromoteAllScalars=true]),",
                "    TypGeändert = Table.TransformColumnTypes(HeadersHochgestuft, {",
                "        {\"verkauf_id\", Int64.Type},",
                "        {\"produkt_id\", type text},",
                "        {\"datum\",      type date},",
                "        {\"menge\",      Int64.Type},",
                "        {\"preis\",      type number},",
                "        {\"umsatz\",     type number}",
                "    })",
                "in",
                "    TypGeändert"
              ]
            }
          }
        ],
        "annotations": [
          { "name": "PBI_ResultType", "value": "Table" }
        ]
      },
