table ModelOutput
	lineageTag: 4933c586-8592-4f4f-ae8b-6afc38c53f6e

	measure 'Aktueller Preis Ø' = AVERAGE(ModelOutput[aktueller_preis])
		formatString: #,0.00 "€"
		displayFolder: Preise
		lineageTag: e261470b-3e6a-4ecb-a06e-d427e3ed4489

	measure 'Empfohlener Preis Ø' = AVERAGE(ModelOutput[empfohlener_preis])
		formatString: #,0.00 "€"
		displayFolder: Preise
		lineageTag: 093d9728-7fb4-4070-ba04-b72c893c6d4e

	measure 'Wettbewerbspreis Ø' = AVERAGE(ModelOutput[wettbewerbspreis])
		formatString: #,0.00 "€"
		displayFolder: Preise
		lineageTag: 4fe92434-0ece-4a32-a004-ebb6504e5f7c

	measure 'Preisänderung Absolut' = [Empfohlener Preis Ø] - [Aktueller Preis Ø]
		formatString: +#,0.00 "€";-#,0.00 "€";0,00 "€"
		displayFolder: Preise
		lineageTag: b4edd876-f11a-4158-8fed-bd29b601e0e6

	measure 'Preisänderung %' = DIVIDE([Empfohlener Preis Ø] - [Aktueller Preis Ø], [Aktueller Preis Ø])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Preise
		lineageTag: bb101d45-0090-484a-8502-556e667c4146

	measure 'Preiselastizität Ø' = AVERAGE(ModelOutput[preiselastizitaet])
		formatString: 0.000
		displayFolder: Modell
		lineageTag: 4bc8514c-3f98-4e52-9756-70ca78b52d0a

	measure 'Modell R² Ø' = AVERAGE(ModelOutput[modell_r2])
		formatString: 0.000
		displayFolder: Modell
		lineageTag: 5fc2a131-8b07-4263-9b16-d81b9e31d18d

	measure 'ΔMenge % Ø' = DIVIDE(AVERAGE(ModelOutput[erwartete_mengenänderung]), 100)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Erwartete Änderungen
		lineageTag: 404a73a2-77bd-47f3-9be2-cca85b5f25fa

	measure 'ΔUmsatz % Ø' = DIVIDE(AVERAGE(ModelOutput[erwartete_umsatzaenderung]), 100)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Erwartete Änderungen
		lineageTag: f3c0e0ce-7246-4762-9867-16b4c8ba9884

	measure 'ΔMarge % Ø' = DIVIDE(AVERAGE(ModelOutput[erwartete_margenänderung]), 100)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Erwartete Änderungen
		lineageTag: 9386c341-69c7-4981-b90e-2eb8e7fd1534

	measure Preis-Elastizitäts-Klasse =
			VAR eps = [Preiselastizität Ø]
			RETURN
			    IF(eps >= 0, "Positiv (Giffen)",
			    IF(eps >= -1, "Unelastisch (|ε| < 1)",
			    IF(eps >= -1.05, "Nahe Einheitselastizität",
			    "Elastisch (|ε| > 1)")))
		displayFolder: Modell
		lineageTag: 83d8918a-72cd-4455-a966-af44d580e367

	measure 'ΔUmsatz positiv Ø' = IF([ΔUmsatz % Ø] >= 0, [ΔUmsatz % Ø], BLANK())
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Erwartete Änderungen
		lineageTag: 7e51a45d-1711-4893-89e5-cd841ea1f944

	measure 'ΔUmsatz negativ Ø' = IF([ΔUmsatz % Ø] < 0, [ΔUmsatz % Ø], BLANK())
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Erwartete Änderungen
		lineageTag: c68f7f1a-fda5-4e96-9470-473640892d08

	measure 'ΔMarge positiv Ø' = IF([ΔMarge % Ø] >= 0, [ΔMarge % Ø], BLANK())
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Erwartete Änderungen
		lineageTag: 9df63c20-3ef3-4d96-a547-69883859f365

	measure 'ΔMarge negativ Ø' = IF([ΔMarge % Ø] < 0, [ΔMarge % Ø], BLANK())
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Erwartete Änderungen
		lineageTag: 455d3d10-1991-4736-b942-5d6b95189f25

